# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings > API in the Supabase dashboard). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret key (Settings > API Keys > Secret keys > Reveal). Server-only —
# no NEXT_PUBLIC_ prefix, never imported by client-side code. Bypasses every
# RLS policy, so treat it like a root password. Only used by
# src/lib/supabase/admin.ts, for the admin-only "add a member" flow, since
# this app has no public sign-up.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
