# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings > API in the Supabase dashboard). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret key (Settings > API Keys > Secret keys > Reveal). Server-only —
# no NEXT_PUBLIC_ prefix, never imported by client-side code. Bypasses every
# RLS policy, so treat it like a root password. Only used by
# src/lib/supabase/admin.ts, for the admin-only "add a member" flow, since
# this app has no public sign-up.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Direct Postgres connection string (Settings > Database > Connection
# string > URI > "Direct connection", with the password filled in — click
# "Reveal" if it shows as ****). Only used by `npm run db:push`, which
# applies supabase/schema.sql straight to the database, no dashboard
# SQL Editor involved. Never commit this — it's effectively the DB's
# root password.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Calendar reminders (web push). Generate the VAPID pair once with
# `npx web-push generate-vapid-keys`; the public half ships to the browser.
# CRON_SECRET is any long random string — the scheduler (see
# .github/workflows/reminders.yml) sends it to /api/cron/reminders.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
CRON_SECRET=your-long-random-string
